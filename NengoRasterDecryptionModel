    "implementation_code": "class NengoRasterMatrix:\n    GRID_DIM: int = 11\n    TOTAL_CELLS: int = 121\n    BASE_OFFSET: int = 0x120A0\n    BASE_CELL: int = 78  # (7, 1)\n    REGISTER_MASK: int = 0xFFFFF\n\n    @classmethod\n    def forward_scan(cls, k: int) -> dict:\n        cell = (cls.BASE_CELL + k) % cls.TOTAL_CELLS\n        y = cell // cls.GRID_DIM\n        x = cell % cls.GRID_DIM\n        offset = (cls.BASE_OFFSET + k) & cls.REGISTER_MASK\n        return {\n            'k': k,\n            'hex_offset': f'0x{offset:05X}',\n            'cell': cell,\n            'coordinate': (y, x)\n        }\n\n    @classmethod\n    def reconstruct_clock_step(cls, y: int, x: int) -> dict:\n        cell = (y * cls.GRID_DIM + x) % cls.TOTAL_CELLS\n        k_mod = (cell - cls.BASE_CELL) % cls.TOTAL_CELLS\n        reconstructed_offset = (cls.BASE_OFFSET + k_mod) & cls.REGISTER_MASK\n        return {\n            'cell': cell,\n            'k_mod_121': k_mod,\n            'hex_offset': f'0x{reconstructed_offset:05X}',\n            'complexity': 'O(1)'\n        }\n\ndef verify_parity(dataset: list) -> bool:\n    for entry in dataset:\n        k = entry['Takt-Schritt (k)']\n        expected_hex = entry['5-Digit-Offset']\n        expected_cell = entry['Zelle (mod 121)']\n        expected_coord = eval(entry['Koordinate (Y, X)'])\n        \n        forward = NengoRasterMatrix.forward_scan(k)\n        assert forward['hex_offset'] == expected_hex, f'Offset mismatch at k={k}'\n        assert forward['cell'] == expected_cell, f'Cell mismatch at k={k}'\n        assert forward['coordinate'] == expected_coord, f'Coord mismatch at k={k}'\n        \n        inv = NengoRasterMatrix.reconstruct_clock_step(expected_coord[0], expected_coord[1])\n        assert inv['k_mod_121'] == (k % 121), f'Inverse step mismatch at k={k}'\n    return True\n"
