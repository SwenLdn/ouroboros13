# 3. Zahlentheoretische Verifikation der 119. Primzahl
def compute_primes_up_to_index(target_count):
    primes = []
    num = 2
    while len(primes) < target_count:
        if all(num % p != 0 for p in primes if p * p <= num):
            primes.append(num)
        num += 1
    return primes

primes = compute_primes_up_to_index(119)
p_119 = primes[-1]
