import pandas as pd
from decimal import Decimal, getcontext

# Hohe Präzision für exakte Dezimalentwicklung von 1/49
getcontext().prec = 60

# Exakte Dezimalentwicklung von 1/49 berechnen
inv_49 = Decimal(1) / Decimal(49)
inv_49_str = str(inv_49)[2:]  # Nachkommastellen

# 1. DataFrame: Schieberegister-Entwicklung k = 1 bis 10
register_steps = []
cumulative_sum = Decimal(0)

for k in range(1, 11):
    power_val = 2**k
    term = Decimal(power_val) / (Decimal(100)**k)
    cumulative_sum += term
    
    # Zweistelliger Zielblock im exakten 1/49-String
    block_start = (k - 1) * 2
    block_digits = inv_49_str[block_start:block_start + 2]
    
    # Klassifikation der Phase
    if k < 6:
        phase_status = "Linear (Carry-frei)"
        carry_out = 0
    elif k == 6:
        phase_status = "Bruchstelle (Carry-In von Block 7)"
        carry_out = 1
    elif k == 7:
        phase_status = "Phasen-Kollaps / Vektor '653'"
        carry_out = 2
    else:
        phase_status = "Kaskadierter Übertrag"
        carry_out = power_val // 100

    register_steps.append({
        "k (Schritt)": k,
        "2^k (Register)": power_val,
        "Term (2^k / 100^k)": f"{term:.20f}".rstrip('0'),
        "Block (Rohwert)": f"{power_val:02d}" if power_val < 100 else str(power_val),
        "Dezimalblock (1/49)": block_digits,
        "Kumulierte Sequenz": str(cumulative_sum)[:2 + k*2],
        "Phasen-Status": phase_status
    })

df_register = pd.DataFrame(register_steps)

